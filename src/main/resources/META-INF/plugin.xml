<idea-plugin>
    <id>com.github.oumaimazerouali.spongebobtheme</id>
    <name>Spongebob Theme</name>
    <vendor url="https://github.com/OumaimaZerouali">Oumaima Zerouali</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <themeProvider id="com.github.oumaimazerouali.spongebobtheme.dark" path="/themes/spongebob.theme.json"/>
        <applicationConfigurable
                parentId="appearance"
                id="com.github.oumaimazerouali.spongebobtheme.settings"
                displayName="Spongebob Theme"
                instance="com.github.oumaimazerouali.spongebobtheme.settings.SpongeConfigurable"/>
        <postStartupActivity implementation="com.github.oumaimazerouali.spongebobtheme.progress.SpongeStartupActivity"/>
    </extensions>

    <applicationListeners>
        <listener class="com.github.oumaimazerouali.spongebobtheme.progress.SpongeLafListener"
                  topic="com.intellij.ide.ui.LafManagerListener"/>
        <listener class="com.github.oumaimazerouali.spongebobtheme.progress.SpongeAppListener"
                  topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

    <actions>
        <action id="com.github.oumaimazerouali.spongebobtheme.VisitEditor"
                class="com.github.oumaimazerouali.spongebobtheme.buddy.VisitEditorAction"
                text="Spongebob Theme: Visit This Editor"
                description="Send the character to sit on a class in this editor right now">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
